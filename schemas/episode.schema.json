{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allascode.dev/schemas/data-learning/episode.schema.json",
  "title": "AllasCode Learning Episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "episode_id",
    "version",
    "execution_id",
    "agent",
    "intent",
    "started_at",
    "finished_at",
    "source_evidence",
    "steps",
    "verification",
    "outcome",
    "lineage"
  ],
  "properties": {
    "episode_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "execution_id": {"type": "string", "minLength": 1},
    "agent": {"type": "string", "minLength": 1},
    "intent": {"type": "string", "minLength": 1},
    "canonical_label": {"type": "string"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "initial_state_hash": {"type": "string"},
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "steps": {
      "type": "array",
      "items": {"$ref": "#/$defs/step"}
    },
    "verification": {"$ref": "#/$defs/verification"},
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["Ok", "Error", "Escalated", "Blocked", "Compromised", "Inconclusive"]},
        "result_hash": {"type": "string"},
        "human_intervention": {"type": "boolean", "default": false}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["builder_version", "content_hash"],
      "properties": {
        "builder_version": {"type": "string"},
        "content_hash": {"type": "string"},
        "previous_episode_hash": {"type": ["string", "null"]}
      }
    }
  },
  "$defs": {
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "uri", "hash"],
      "properties": {
        "type": {"enum": ["event", "trace", "log", "metric", "proof", "source", "config", "test", "human", "other"]},
        "uri": {"type": "string", "minLength": 1},
        "hash": {"type": "string", "minLength": 1},
        "producer": {"type": "string"},
        "captured_at": {"type": "string", "format": "date-time"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["index", "kind"],
      "properties": {
        "index": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["observation", "hypothesis", "decision", "action", "mutation", "verification", "escalation"]},
        "actor": {"type": "string"},
        "action": {"type": "string"},
        "input_hash": {"type": "string"},
        "output_hash": {"type": "string"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verifier", "status", "evidence_refs"],
      "properties": {
        "verifier": {"type": "string"},
        "status": {"enum": ["accepted", "rejected", "inconclusive", "compromised", "blocked"]},
        "proof_hash": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
